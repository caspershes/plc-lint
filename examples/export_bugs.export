<Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable"><Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable"><Single Name="Name">GVL</Single><Single Name="TypeGuid">ffbfa93a-b94d-45fc-a329-229860183b1d</Single><Single Name="Guid">00000000-0000-0000-0000-171836181641</Single></Single><Single Name="Object" Type="{ffbfa93a-b94d-45fc-a329-229860183b1d}" Method="IArchivable"><Array Name="TextLines"><Single><Single Name="Id">1</Single><Single Name="Text">{attribute 'qualified_only'}</Single></Single><Single><Single Name="Id">2</Single><Single Name="Text">VAR_GLOBAL</Single></Single><Single><Single Name="Id">3</Single><Single Name="Text">	t_out : REAL;              // наружная температура, канал 1</Single></Single><Single><Single Name="Id">4</Single><Single Name="Text">	t_podacha : REAL;          // подача, канал 2</Single></Single><Single><Single Name="Id">5</Single><Single Name="Text">	err3 : WORD;</Single></Single><Single><Single Name="Id">6</Single><Single Name="Text">	act_privod : REAL;</Single></Single><Single><Single Name="Id">7</Single><Single Name="Text">	run_pump : BOOL;           // команда с экрана</Single></Single><Single><Single Name="Id">8</Single><Single Name="Text">	alarm_pump_1 : BOOL;</Single></Single><Single><Single Name="Id">9</Single><Single Name="Text">	t_nasos_1 : REAL;</Single></Single><Single><Single Name="Id">10</Single><Single Name="Text">	t_nasos_2 : REAL;</Single></Single><Single><Single Name="Id">11</Single><Single Name="Text">	set_temp : REAL := 60;</Single></Single><Single><Single Name="Id">12</Single><Single Name="Text">	act_FH1 : REAL;</Single></Single><Single><Single Name="Id">13</Single><Single Name="Text">	alarm_kotel : ARRAY [1..3] OF BOOL;</Single></Single><Single><Single Name="Id">14</Single><Single Name="Text">END_VAR</Single></Single></Array></Single></Single>
<Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable"><Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable"><Single Name="Name">PLC_PRG</Single><Single Name="TypeGuid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single><Single Name="Guid">00000000-0000-0000-0000-812757677025</Single></Single><Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable"><Array Name="TextLines"><Single><Single Name="Id">1</Single><Single Name="Text">work_pumps();</Single></Single></Array><Array Name="TextLines"><Single><Single Name="Id">1</Single><Single Name="Text">PROGRAM PLC_PRG</Single></Single><Single><Single Name="Id">2</Single><Single Name="Text">VAR</Single></Single><Single><Single Name="Id">3</Single><Single Name="Text">END_VAR</Single></Single></Array></Single></Single>
<Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable"><Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable"><Single Name="Name">work_pumps</Single><Single Name="TypeGuid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single><Single Name="Guid">00000000-0000-0000-0000-909819581163</Single></Single><Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable"><Array Name="TextLines"><Single><Single Name="Id">1</Single><Single Name="Text">gvl.alarm_pump_1 := gvl.err3 &gt; 0;    // источник аварии насоса</Single></Single><Single><Single Name="Id">2</Single><Single Name="Text">// уставка в миллисекундах: умножение ПОСЛЕ преобразования теряет дробь</Single></Single><Single><Single Name="Id">3</Single><Single Name="Text">tm := REAL_TO_TIME(set_time) * 1000;</Single></Single><Single><Single Name="Id">4</Single><Single Name="Text">// pause нигде не вызывается, а её выход читают — выдержки не будет</Single></Single><Single><Single Name="Id">5</Single><Single Name="Text">IF pause.Q THEN</Single></Single><Single><Single Name="Id">6</Single><Single Name="Text">	gvl.act_privod := 100;</Single></Single><Single><Single Name="Id">7</Single><Single Name="Text">END_IF</Single></Single><Single><Single Name="Id">8</Single><Single Name="Text">IF gvl.run_pump AND NOT gvl.alarm_pump_1 THEN</Single></Single><Single><Single Name="Id">9</Single><Single Name="Text">	gvl.act_privod := gvl.set_temp;</Single></Single><Single><Single Name="Id">10</Single><Single Name="Text">END_IF</Single></Single></Array><Array Name="TextLines"><Single><Single Name="Id">1</Single><Single Name="Text">PROGRAM work_pumps</Single></Single><Single><Single Name="Id">2</Single><Single Name="Text">VAR</Single></Single><Single><Single Name="Id">3</Single><Single Name="Text">	pause : TON;</Single></Single><Single><Single Name="Id">4</Single><Single Name="Text">	set_time : REAL := 1.5;</Single></Single><Single><Single Name="Id">5</Single><Single Name="Text">	tm : TIME;</Single></Single><Single><Single Name="Id">6</Single><Single Name="Text">END_VAR</Single></Single></Array></Single></Single>
